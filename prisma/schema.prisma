generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  EXPIRED
}

enum PaymentMethod {
  CASH
  MERCADO_PAGO
  QUOTE
}

enum ServicePricingType {
  FIXED
  QUOTE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  NOT_REQUIRED
}

enum ExceptionType {
  CLOSED
  CUSTOM_HOURS
}

model Service {
  id              String             @id @default(cuid())
  name            String
  slug            String             @unique
  description     String
  pricingType     ServicePricingType @default(FIXED)
  priceCents      Int?
  quoteLabel      String?
  durationMinutes Int
  isActive        Boolean            @default(true)
  displayOrder    Int                @default(0)
  imageKey        String?
  imageUrl        String?
  appointments    Appointment[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([isActive, displayOrder])
}

model Appointment {
  id                         String             @id @default(cuid())
  bookingCode                String             @unique
  publicTokenHash            String?            @unique
  needsReview                Boolean            @default(false)
  transactions               PaymentTransaction[]
  customerName               String
  phone                      String
  email                      String?
  instagram                  String?
  notes                      String?
  serviceId                  String
  service                    Service            @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceNameSnapshot        String
  servicePricingTypeSnapshot ServicePricingType @default(FIXED)
  servicePriceSnapshot       Int?
  serviceQuoteLabelSnapshot  String?
  serviceDurationSnapshot    Int
  startAt                    DateTime           @db.Timestamptz(3)
  endAt                      DateTime           @db.Timestamptz(3)
  timezone                   String             @default("America/Monterrey")
  status                     AppointmentStatus  @default(PENDING)
  paymentMethod              PaymentMethod
  paymentStatus              PaymentStatus
  amountCents                Int?
  paymentPreferenceId        String?            @unique
  paymentId                  String?            @unique
  pendingExpiresAt           DateTime?          @db.Timestamptz(3)
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  @@index([startAt, endAt])
  @@index([status, startAt])
  @@index([paymentStatus, pendingExpiresAt])
  @@index([serviceId])
}

model PaymentTransaction {
  id             String @id @default(cuid())
  paymentId      String @unique
  appointmentId  String
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  status         String
  amountCents    Int
  currency       String
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
  @@index([appointmentId])
}

model RateLimit {
  key String @id
  count Int @default(1)
  resetAt DateTime @db.Timestamptz(3)
}

model WeeklySchedule {
  id        String   @id @default(cuid())
  weekday   Int
  startTime String
  endTime   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weekday, sortOrder])
}

model ScheduleException {
  id        String        @id @default(cuid())
  date      DateTime      @db.Date
  type      ExceptionType
  startTime String?
  endTime   String?
  label     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([date, type, startTime, endTime])
  @@index([date])
}

model BlockedPeriod {
  id        String   @id @default(cuid())
  startAt   DateTime @db.Timestamptz(3)
  endAt     DateTime @db.Timestamptz(3)
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startAt, endAt])
}

model GalleryImage {
  id           String   @id @default(cuid())
  objectKey    String   @unique
  url          String
  alt          String?
  width        Int?
  height       Int?
  isActive     Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, displayOrder])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PaymentEvent {
  id              String   @id @default(cuid())
  externalEventId String   @unique
  eventType       String
  paymentId       String?
  payload         Json
  processedAt     DateTime @default(now())

  @@index([paymentId])
}
